{
  "name": "samtor-pair",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // No "routes" here on purpose. The public hostname is deliberately absent from
  // this repository; scripts/with-route.mjs injects it from PAIR_HOSTNAME at deploy
  // time and writes wrangler.deploy.json, which is gitignored.
  // Without PAIR_HOSTNAME the Worker simply deploys to its workers.dev subdomain.

  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "PairSession" },
      { "name": "MIRRORS", "class_name": "MirrorSession" }
    ]
  },

  // SQLite is the only Durable Object backend available on the Workers Free plan,
  // and the recommended one on any plan.
  //
  // A new class needs its own tag. Tags are applied once, in order, and the
  // runtime remembers which it has seen — adding MirrorSession to v1 after v1
  // has shipped would deploy cleanly and never create the class.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairSession"] },
    { "tag": "v2", "new_sqlite_classes": ["MirrorSession"] }
  ],

  // Rate limits. See src/limits.js for what each key is and why the ceilings sit
  // where they do. Trailing comments are not allowed in this file: with-route.mjs
  // strips whole-line // comments only, and a trailing one would break the parse.
  //
  // A namespace_id is account-wide, so two bindings sharing one share a counter.
  // These three are distinct because they count three different things.
  "ratelimits": [
    {
      "name": "RL_CREATE",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_LOOKUP",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_CODE",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
