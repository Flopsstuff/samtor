# Tool configuration for tools/. Copy to .env and adjust for your setup.
# .env is in .gitignore — it will not be committed to the repository.
#
# Precedence: environment variables > .env > defaults in tools/config.py

# Monitor address on the local network.
# 192.0.2.10 is a documentation-only address (RFC 5737) — replace it with your monitor's IP.
SAMTOR_HOST=192.0.2.10

# Name the script presents to the monitor.
# Visible in the allowed-devices list:
# Settings -> General -> External Device Manager -> Device Connection Manager
# Changing it after pairing makes the monitor ask for on-screen approval again,
# so an already-paired setup should keep whatever name it was paired with.
SAMTOR_CLIENT_NAME=tvctl

# Path to the pairing token file. Default is token.txt in the project root.
# WARNING: do NOT put the token itself here. The samsungtvws library
# rewrites this file when the monitor rotates the token — that is state,
# not configuration. Only the path belongs here.
# SAMTOR_TOKEN=/absolute/path/to/token.txt

# SDB port, available only when Developer Mode is enabled
SAMTOR_SDB_PORT=26101
